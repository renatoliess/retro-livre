---
// Player do EmulatorJS (GPL-3.0). Usa sempre o núcleo fixado em consoles.ts,
// para nunca carregar um núcleo com licença "não comercial".
import { CONSOLES, type ConsoleId } from '../consoles';
import { url, type Lang } from '../i18n';

interface Props {
  console: ConsoleId;
  rom: string;
  titulo: string;
  lang: Lang;
}
const { console: consoleId, rom, titulo, lang } = Astro.props;

const nucleo = CONSOLES[consoleId].sistema;
const romUrl = url(`/roms/${rom}`).replace(/\/$/, '');
const dados = 'https://cdn.emulatorjs.org/stable/data/';
const idioma = lang === 'pt' ? 'pt-BR' : 'en-US';
---
<div class="moldura">
  <div id="jogo" aria-label={titulo}></div>
</div>

<script is:inline define:vars={{ nucleo, romUrl, dados, idioma, titulo }}>
  window.EJS_player = '#jogo';
  window.EJS_core = nucleo;
  window.EJS_gameUrl = romUrl;
  window.EJS_gameName = titulo;
  window.EJS_pathtodata = dados;
  window.EJS_language = idioma;
  window.EJS_color = '#ff6b5b';
  window.EJS_startOnLoaded = false;
  const s = document.createElement('script');
  s.src = dados + 'loader.js';
  document.body.appendChild(s);
</script>

<style>
  .moldura {
    max-width: 768px; aspect-ratio: 4 / 3; background: #000;
    border: 2px solid var(--borda); border-radius: 6px; overflow: hidden;
  }
  #jogo { width: 100%; height: 100%; }
</style>
